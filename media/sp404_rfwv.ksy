# Imported from https://github.com/iare-digital/open404/blob/294d5cb8278d07295d01c645bca67fb7b158c3a5/specs/sp404_rfwv.ksy
meta:
  id: sp404_rfwv
  title: Roland SP-404MKII Sample Header Format (RFWV)
  application: Roland SP-404MKII (Firmware v5.51)
  license: MIT
  endian: be

doc: |
  Describes the mandatory 512-byte RFWV header prepended to audio files (.SMP)
  stored in the SP-404MKII flash memory (/PROJECT_XX/SMPL/).
  Includes the reverse-engineered MD5 checksum and pseudo-random MSVCRT rand()
  cache block.

seq:
  - id: magic
    contents: "RFWV"
    doc: Fixed 4-byte ASCII magic identifier 'RFWV'.
  - id: chunk_size
    type: u4
    doc: Total byte count of the audio payload following the 512-byte header.
  - id: sample_rate
    type: u4
    doc: Audio sampling rate in Hertz (typically 48000 Hz).
  - id: channels
    type: u4
    doc: Number of audio channels (1 = Mono, 2 = Stereo).
  - id: bit_depth
    type: u4
    doc: Bit depth per sample (typically 16-bit linear PCM).
  - id: reserved
    size: 12
    doc: Reserved padding bytes (zeros).
  - id: md5_hash
    size: 16
    doc: |
      MD5 cryptographic hash of the 16 bytes preceding offset 32:
      [chunk_size (4B BE), sample_rate (4B BE), channels (4B BE), bit_depth (4B BE)].
  - id: cache_data
    size: 464
    doc: |
      464-byte pseudo-random cache block generated by MSVCRT rand() seeded with
      srand(0).
